# Database Configurations
# Change DB_ENGINE to 'mysql' to use MySQL. Default fallback is 'sqlite3'.
DB_ENGINE=sqlite3

# MySQL Configurations (used if DB_ENGINE=mysql)
DB_NAME=task_manager
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Alternatively, you can use a single DATABASE_URL connection string:
# DATABASE_URL=mysql://root:your_mysql_password@127.0.0.1:3306/task_manager
